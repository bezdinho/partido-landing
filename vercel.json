{
  "rewrites": [
    { "source": "/g/:code", "destination": "/api/group-link?code=:code" },
    { "source": "/m/:id", "destination": "/api/match-link?id=:id" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
